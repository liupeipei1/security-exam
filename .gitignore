# 忽略临时文件
*.tmp
*.log
*.swp
*.bak

# 忽略 node_modules（如果使用 npm）
node_modules/
frontend/dist/

# 忽略系统文件
.DS_Store
Thumbs.db

# 忽略 IDE 配置
.vscode/
.idea/
*.iml

# 忽略 build 目录和 Gradle 缓存
backend/**/build/
backend/**/.gradle/
backend/build/
backend/.gradle/
/backend/*/build/
/backend/.gradle/
/backend/build/

# 忽略环境变量文件（保留模板）
.env
.env.local
.env.*.local
!.env.example
!.env.dev
!.env.uat
!.env.prod

# Docker volumes
docker-volume/
