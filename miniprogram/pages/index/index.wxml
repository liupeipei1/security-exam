<!-- 加载状态 -->
<view wx:if="{{loading}}" class="loading-container">
  <view class="loading-spinner"></view>
  <text class="loading-text">加载中...</text>
</view>

<!-- 未登录状态 -->
<view wx:elif="{{!isLoggedIn}}" class="login-page">
  <view class="login-logo">
    <text class="logo-text">🛡️</text>
  </view>
  <view class="login-title">考试刷题系统</view>
  
  <view class="login-btn" bindtap="wxLogin">
    <text class="login-btn-icon">👤</text>
    <text class="login-btn-text">微信登录</text>
  </view>
  
  <view class="login-tips">
    <text>登录后可体验更多功能</text>
  </view>
</view>

<!-- 已登录状态 - 直接显示题库内容 -->
<view wx:else class="main-content">
  <!-- 顶部导航 -->
  <view class="top-nav">
    <text class="nav-title">考试刷题系统</text>
    <view class="nav-right">
      <view class="logout-btn" bindtap="logout">退出登录</view>
    </view>
  </view>
  
  <!-- 题库选择器 - 使用picker组件 -->
  <picker mode="selector" range="{{exams}}" range-key="exam_name" value="{{examIndex}}" bindchange="onExamChange">
    <view class="exam-selector">
      <view class="exam-selected">
        <text class="exam-name">{{currentExam ? currentExam.exam_name : '请选择题库'}}</text>
        <text class="exam-arrow">▼</text>
      </view>
    </view>
  </picker>
  
  <!-- 模式切换 -->
  <view class="mode-tabs">
    <view class="mode-tab {{currentMode === 'practice' ? 'active' : ''}}" bindtap="switchMode" data-mode="practice">
      <text class="mode-title">练习模式</text>
      <text class="mode-count">共 {{allQuestions.length}} 题</text>
    </view>
    <view class="mode-tab {{currentMode === 'exam' ? 'active' : ''}}" bindtap="switchMode" data-mode="exam">
      <text class="mode-title">考试模式</text>
      <text class="mode-count">共 {{examQuestionCount}} 题</text>
    </view>
  </view>
  
  <!-- 题型统计 -->
  <view class="type-stats">
    <view class="type-item {{currentQuestionType === 'all' ? 'active' : ''}}" bindtap="switchQuestionType" data-type="all">
      <view class="type-icon all">全部</view>
      <text class="type-name">全部题型</text>
      <text class="type-count">{{totalQuestionCount}}</text>
    </view>
    <view class="type-item {{currentQuestionType === 'judgment' ? 'active' : ''}}" bindtap="switchQuestionType" data-type="judgment">
      <view class="type-icon judgment">判</view>
      <text class="type-name">判断题</text>
      <text class="type-count">{{judgmentCount}}</text>
    </view>
    <view class="type-item {{currentQuestionType === 'single' ? 'active' : ''}}" bindtap="switchQuestionType" data-type="single">
      <view class="type-icon single">单</view>
      <text class="type-name">单选题</text>
      <text class="type-count">{{singleCount}}</text>
    </view>
    <view class="type-item {{currentQuestionType === 'multiple' ? 'active' : ''}}" bindtap="switchQuestionType" data-type="multiple">
      <view class="type-icon multiple">多</view>
      <text class="type-name">多选题</text>
      <text class="type-count">{{multipleCount}}</text>
    </view>
  </view>
  
  <!-- 题目卡片 -->
  <view class="question-card">
    <!-- 进度条 -->
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{progressPercent}}%"></view>
    </view>
    
    <!-- 题目头部 -->
    <view class="question-header">
      <text class="question-number">第 {{currentQuestionIndex + 1}} / {{currentQuestions.length}} 题</text>
      <text class="question-type {{currentQuestionData.type}}">{{getQuestionTypeLabel(currentQuestionData.type)}}</text>
      <view class="favorite-btn" bindtap="toggleFavorite">
        <text class="favorite-icon">{{isCurrentQuestionFavorited() ? '❤️' : '🤍'}}</text>
      </view>
    </view>
    
    <!-- 题目内容 -->
    <view class="question-content">{{currentQuestionData.question}}</view>
    
    <!-- 选项列表 -->
    <view class="options-list">
      <view wx:for="{{currentQuestionData.options}}" wx:key="*this" 
            class="option-item {{selectedFlags[index] ? 'selected' : ''}} {{showAnswer && isCorrectOption(index) ? 'correct' : ''}} {{showAnswer && isSelectedWrong(index) ? 'wrong' : ''}}" 
            bindtap="selectOption" data-index="{{index}}">
        <view class="option-content">
          <view class="option-label">{{getOptionLabel(index)}}</view>
          <text class="option-text">{{item}}</text>
        </view>
        <view wx:if="{{showAnswer && isCorrectOption(index)}}" class="option-icon correct">✓</view>
        <view wx:if="{{showAnswer && isSelectedWrong(index)}}" class="option-icon wrong">✗</view>
      </view>
    </view>
    
    <!-- 答案解析 -->
    <view wx:if="{{showAnswer}}" class="answer-analysis">
      <view class="analysis-title">📖 答案解析</view>
      <view class="correct-answer">
        <text class="answer-label">正确答案：</text>
        <text class="answer-value">{{currentQuestionData.answer}}</text>
      </view>
      <textarea 
        class="analysis-content" 
        value="{{currentQuestionData.analysis}}" 
        bindinput="onAnalysisInput"
        placeholder="请输入答案解析"
      ></textarea>
      <button class="save-analysis-btn" bindtap="saveAnalysis">保存解析</button>
    </view>
    
    <!-- 操作按钮 -->
    <view class="action-buttons">
      <button class="action-btn reset" bindtap="resetAnswer" wx:if="{{showAnswer}}">重置</button>
      <button class="action-btn submit" bindtap="submitAnswer" wx:else>提交答案</button>
      <button class="action-btn next" bindtap="nextQuestion" wx:if="{{showAnswer && currentQuestionIndex < currentQuestions.length - 1}}">下一题</button>
    </view>
  </view>
  
  <!-- 考试模式提交按钮 -->
  <view wx:if="{{currentMode === 'exam'}}" class="exam-submit-section">
    <button class="exam-submit-btn" bindtap="submitExam">
      <text class="submit-icon">📝</text>
      <text class="submit-text">提交考试</text>
    </button>
  </view>
  
  <!-- 分页导航 -->
  <view class="pagination">
    <button class="page-btn" bindtap="prevQuestion" disabled="{{currentQuestionIndex === 0}}">上一题</button>
    <text class="page-info">{{currentQuestionIndex + 1}} / {{currentQuestions.length}}</text>
    <button class="page-btn" bindtap="nextQuestion" disabled="{{currentQuestionIndex === currentQuestions.length - 1}}">下一题</button>
  </view>
  
  <!-- 底部导航 -->
  <view class="bottom-nav">
    <view class="nav-item {{currentView === 'home' ? 'active' : ''}}" bindtap="switchView" data-view="home">
      <text class="nav-icon">📚</text>
      <text class="nav-label">题库</text>
    </view>
    <view class="nav-item" bindtap="showFavorites">
      <text class="nav-icon">❤️</text>
      <text class="nav-label">收藏</text>
    </view>
    <view class="nav-item {{currentView === 'stats' ? 'active' : ''}}" bindtap="showStats">
      <text class="nav-icon">📊</text>
      <text class="nav-label">统计</text>
    </view>
    <view class="nav-item" bindtap="logout">
      <text class="nav-icon">👤</text>
      <text class="nav-label">退出</text>
    </view>
  </view>
</view>

<!-- 统计弹窗 -->
<view wx:if="{{showStatsModal}}" class="modal-overlay" bindtap="closeStatsModal">
  <view class="modal-container" bindtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">学习统计</text>
      <view class="modal-close" bindtap="closeStatsModal">✕</view>
    </view>
    <view class="modal-body">
      <view class="stats-grid">
        <view class="stat-card">
          <text class="stat-icon">📝</text>
          <text class="stat-value">{{answeredCount}}</text>
          <text class="stat-label">已做题目</text>
        </view>
        <view class="stat-card">
          <text class="stat-icon">✓</text>
          <text class="stat-value">{{correctCount}}</text>
          <text class="stat-label">正确数量</text>
        </view>
        <view class="stat-card">
          <text class="stat-icon">📈</text>
          <text class="stat-value">{{accuracyRate}}%</text>
          <text class="stat-label">正确率</text>
        </view>
        <view class="stat-card">
          <text class="stat-icon">📚</text>
          <text class="stat-value">{{allQuestions.length}}</text>
          <text class="stat-label">总题数</text>
        </view>
      </view>
      
      <view class="stats-section">
        <text class="section-title">题型分布</text>
        <view class="type-distribution">
          <view class="type-item-row">
            <view class="type-color" style="background: #52c41a"></view>
            <text class="type-text">判断题</text>
            <text class="type-count-num">{{judgmentCount}} 题</text>
          </view>
          <view class="type-item-row">
            <view class="type-color" style="background: #1890ff"></view>
            <text class="type-text">单选题</text>
            <text class="type-count-num">{{singleCount}} 题</text>
          </view>
          <view class="type-item-row">
            <view class="type-color" style="background: #faad14"></view>
            <text class="type-text">多选题</text>
            <text class="type-count-num">{{multipleCount}} 题</text>
          </view>
        </view>
      </view>
      
      <view class="suggestion-box">
        <text>💡 学习建议：继续保持，每天坚持练习效果更好！</text>
      </view>
    </view>
  </view>
</view>

<!-- 提交确认弹窗 -->
<view wx:if="{{showSubmitConfirm}}" class="modal-overlay" bindtap="cancelSubmitExam">
  <view class="modal-container submit-modal" bindtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">确认提交</text>
      <view class="modal-close" bindtap="cancelSubmitExam">✕</view>
    </view>
    <view class="modal-body">
      <view class="submit-summary">
        <view class="summary-row">
          <text class="summary-label">总题数</text>
          <text class="summary-value">{{currentQuestions.length}} 题</text>
        </view>
        <view class="summary-row">
          <text class="summary-label">已答题</text>
          <text class="summary-value answered">{{answeredCount}} 题</text>
        </view>
        <view class="summary-row">
          <text class="summary-label">未答题</text>
          <text class="summary-value unanswered">{{currentQuestions.length - answeredCount}} 题</text>
        </view>
      </view>
      
      <view class="question-status-header">
        <text class="status-title">答题状态</text>
        <view class="status-legend">
          <view class="legend-item">
            <view class="legend-dot answered"></view>
            <text>已答</text>
          </view>
          <view class="legend-item">
            <view class="legend-dot unanswered"></view>
            <text>未答</text>
          </view>
        </view>
      </view>
      
      <scroll-view class="question-grid-scroll" scroll-y>
        <view class="question-grid">
          <view wx:for="{{currentQuestions}}" wx:key="index" 
                class="question-num {{questionAnswers[index] ? 'answered' : 'unanswered'}}"
                bindtap="goToQuestion" data-index="{{index}}">
            {{index + 1}}
          </view>
        </view>
      </scroll-view>
      
      <view class="submit-actions">
        <button class="submit-btn cancel" bindtap="cancelSubmitExam">继续答题</button>
        <button class="submit-btn confirm" bindtap="confirmSubmitExam">确认提交</button>
      </view>
    </view>
  </view>
</view>

<!-- 结果弹窗 -->
<view wx:if="{{showResult}}" class="modal-overlay" bindtap="closeResultModal">
  <view class="modal-container" bindtap="stopPropagation">
    <view class="result-container">
      <text class="result-score">{{accuracyRate}}</text>
      <text class="result-title">考试完成</text>
      <text class="result-subtitle">恭喜您完成本次考试</text>
      
      <view class="result-stats">
        <view class="result-stat-item">
          <text class="result-stat-value">{{answeredCount}}</text>
          <text class="result-stat-label">总题数</text>
        </view>
        <view class="result-stat-item">
          <text class="result-stat-value">{{correctCount}}</text>
          <text class="result-stat-label">正确</text>
        </view>
        <view class="result-stat-item">
          <text class="result-stat-value">{{answeredCount - correctCount}}</text>
          <text class="result-stat-label">错误</text>
        </view>
      </view>
      
      <view class="result-actions">
        <button class="action-btn reset" bindtap="closeResultModal">关闭</button>
        <button class="action-btn next" bindtap="restartExam">重新开始</button>
      </view>
    </view>
  </view>
</view>

<!-- 登录弹窗 -->
<view wx:if="{{showLoginModal}}" class="modal-overlay" bindtap="closeLoginModal">
  <view class="modal-container" bindtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">用户登录</text>
      <view class="modal-close" bindtap="closeLoginModal">✕</view>
    </view>
    <view class="modal-body">
      <view class="login-modal-content">
        <text class="login-modal-icon">👤</text>
        <text class="login-modal-title">请登录以继续</text>
        <text class="login-modal-desc">登录后可体验全部功能</text>
        <view class="login-modal-btn" bindtap="wxLogin">
          <text class="login-modal-btn-icon">📱</text>
          <text class="login-modal-btn-text">微信登录</text>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 付费弹窗 -->
<view wx:if="{{showPayModal}}" class="modal-overlay" bindtap="closePayModal">
  <view class="modal-container pay-modal" bindtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">开通会员</text>
      <view class="modal-close" bindtap="closePayModal">✕</view>
    </view>
    <view class="modal-body">
      <view class="pay-plans">
        <view class="pay-plan {{selectedPackage === 'monthly' ? 'active' : ''}}" bindtap="selectPackage" data-type="monthly">
          <text class="pay-plan-price">¥{{priceConfig.monthly}}</text>
          <text class="pay-plan-duration">1个月</text>
          <text class="pay-plan-discount">原价¥29.9</text>
        </view>
        <view class="pay-plan {{selectedPackage === 'quarterly' ? 'active' : ''}}" bindtap="selectPackage" data-type="quarterly">
          <text class="pay-plan-price">¥{{priceConfig.quarterly}}</text>
          <text class="pay-plan-duration">3个月</text>
          <text class="pay-plan-discount">省¥30</text>
        </view>
        <view class="pay-plan {{selectedPackage === 'yearly' ? 'active' : ''}}" bindtap="selectPackage" data-type="yearly">
          <text class="pay-plan-price">¥{{priceConfig.yearly}}</text>
          <text class="pay-plan-duration">1年</text>
          <text class="pay-plan-discount">省¥228</text>
          <view class="pay-plan-tag">最优惠</view>
        </view>
      </view>
      
      <view class="pay-benefits">
        <text class="pay-benefits-title">会员权益</text>
        <view class="pay-benefit-item">✓ 全部题库（500+题目）</view>
        <view class="pay-benefit-item">✓ 练习模式无限制</view>
        <view class="pay-benefit-item">✓ 模拟考试功能</view>
        <view class="pay-benefit-item">✓ 学习统计分析</view>
        <view class="pay-benefit-item">✓ 答案解析</view>
      </view>
      
      <view class="pay-btn" bindtap="pay">
        <text>立即支付 ¥{{selectedPrice || priceConfig.monthly}}</text>
      </view>
      
      <view class="pay-tips">
        <text>支付即表示同意《会员服务协议》</text>
      </view>
    </view>
  </view>
</view>

<!-- 收藏列表弹窗 -->
<view wx:if="{{showFavoritesModal}}" class="modal-overlay" bindtap="closeFavoritesModal">
  <view class="modal-container favorites-modal" bindtap="stopPropagation">
    <view class="modal-header">
      <text class="modal-title">❤️ 我的收藏</text>
      <view class="modal-close" bindtap="closeFavoritesModal">✕</view>
    </view>
    <view class="modal-body">
      <!-- 加载状态 -->
      <view wx:if="{{favoritesLoading}}" class="loading-container">
        <view class="loading-spinner"></view>
        <text class="loading-text">加载中...</text>
      </view>
      
      <!-- 无收藏 -->
      <view wx:elif="{{favorites.length === 0 && !favoritesLoading}}" class="empty-state">
        <text class="empty-icon">📭</text>
        <text class="empty-title">暂无收藏</text>
        <text class="empty-desc">去题库中收藏一些题目吧</text>
      </view>
      
      <!-- 收藏列表 -->
      <scroll-view wx:else scroll-y class="favorites-list">
        <view wx:for="{{favorites}}" wx:key="id" class="favorite-item" bindtap="viewFavoriteQuestion" data-question-id="{{item.id}}">
          <view class="favorite-item-header">
            <text class="favorite-item-type {{item.type}}">{{getQuestionTypeLabel(item.type)}}</text>
            <view class="favorite-item-actions">
              <view class="remove-favorite-btn" bindtap="removeFromFavorites" data-question-id="{{item.id}}">
                <text>✕</text>
              </view>
            </view>
          </view>
          <text class="favorite-item-question">{{item.question}}</text>
          <!-- 选项列表 -->
          <view class="favorite-item-options">
            <view wx:for="{{item.options}}" wx:key="index" class="favorite-option-item">
              <text class="favorite-option-label">{{getOptionLabel(index)}}.</text>
              <text class="favorite-option-text">{{item}}</text>
            </view>
          </view>
          <view class="favorite-item-footer">
            <text class="favorite-item-answer">答案：{{item.answer}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>