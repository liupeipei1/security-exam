# ============== 环境变量模板 ==============
# 请复制为对应环境的文件并填写实际值：
#   开发环境: cp .env.example .env.dev
#   UAT环境:  cp .env.example .env.uat
#   生产环境: cp .env.example .env.prod
# ==========================================

# ============== 公共配置 ==============
# Spring Profile: dev / uat / prod
SPRING_PROFILES_ACTIVE=dev

# ============== MySQL 配置 ==============
# 数据库名命名规则：
#   Dev:  exam-db-dev
#   UAT:  exam-db-uat
#   Prod: exam-db
DB_HOST=localhost
DB_PORT=3306
DB_NAME=exam-db-dev
DB_USER=peipei
DB_PASSWORD=298280
DB_ROOT_PASSWORD=root123456

# ============== Redis 配置 ==============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============== JWT 配置 ==============
# 生产环境务必修改为32位以上的强随机密钥
JWT_SECRET=your-32-char-minimum-secret-key-here!!
JWT_EXPIRATION_HOURS=168

# ============== 微信小程序 ==============
WECHAT_APPID=
WECHAT_APPSECRET=
WECHAT_QR_REDIRECT_URI=http://localhost:8080/api/auth/qrcode/callback

# ============== 微信支付 ==============
# Dev/UAT: false（开发模式直接开通VIP）
# Prod:     true
WECHAT_PAY_ENABLED=false
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_KEY=
WECHAT_PAY_NOTIFY_URL=http://localhost:8080/api/pay/notify

# ============== 前端 Vite ==============
# Dev:  留空则使用 Vite 代理 /api -> http://localhost:8080
# UAT:  http://uat-api.yourdomain.com
# Prod: https://api.yourdomain.com
VITE_API_BASE=
VITE_WECHAT_APPID=
