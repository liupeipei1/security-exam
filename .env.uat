# ============== 公共配置 ==============
# Spring Profile (dev/uat/prod)
SPRING_PROFILES_ACTIVE=uat

# ============== MySQL 配置 ==============
DB_HOST=localhost
DB_PORT=3306
DB_NAME=exam-db-uat
